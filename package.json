{
  "name": "@better-claw/sdk",
  "version": "0.1.0",
  "description": "JavaScript SDK for chatting with BetterClaw agents over REST + WebSocket streaming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-claw/sdk-js.git"
  },
  "homepage": "https://github.com/better-claw/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/better-claw/sdk-js/issues"
  },
  "keywords": [
    "betterclaw",
    "agent",
    "chat",
    "sdk",
    "streaming",
    "websocket"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0"
}
